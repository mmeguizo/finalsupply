# Required
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
SESSION_SECRET=

# Optional (defaults shown)
# PORT=4000
# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=false
# BODY_LIMIT=1mb
